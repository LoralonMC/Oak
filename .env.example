# ============================================================================
# Oak Discord Bot - Environment Variables
# ============================================================================
# Only secrets and global settings should be here.
# Branch-specific settings belong in branches/<branch_name>/config.yml
# ============================================================================

# Discord Bot Token (REQUIRED - Secret, never share!)
# Get from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Guild ID (Global setting)
GUILD_ID=your_guild_id_here

# Command prefix for text commands (default: "!")
COMMAND_PREFIX=!

# Dev mode: enables debug logging, file watcher, skips auto-sync
# DEV_MODE=true

# Audit log channel ID (0 or omit to disable)
# AUDIT_LOG_CHANNEL=0

# Database backup interval in hours (0 or omit to disable periodic backups)
# DB_BACKUP_INTERVAL=0
# Number of recent backups to keep per branch (default: 3)
# DB_BACKUP_MAX_COUNT=3
